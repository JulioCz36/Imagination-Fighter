:root {
}

.unity-progress-bar {
    max-height: 60%;
}

.unity-progress-bar__container {
    height: 100%;
    max-height: 70px;
}

.unity-progress-bar__background {
    background-image: url("project://database/Assets/Sprite/UI/recortes_papel_rojo.png?fileID=6714107658963849706&guid=7ba010c7284b2334d8c07c3b0871f52b&type=3#recortes_papel_rojo_7");
    background-color: rgba(55, 55, 55, 0);
}

.unity-progress-bar__progress {
    background-image: url("project://database/Assets/Sprite/UI/textura_papel_amarillo.png?fileID=2800000&guid=17be7e782879634439eb5e833959dd84&type=3#textura_papel_amarillo");
    max-height: 60px;
    height: 50px;
    align-self: auto;
    position: absolute;
    top: -5px;
    left: -2px;
}
